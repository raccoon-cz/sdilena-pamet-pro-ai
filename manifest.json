{
  "manifest_version": 3,
  "name": "Sdílená paměť pro AI",
  "version": "0.1.0",
  "description": "Jedna soukromá paměť pro ChatGPT a Claude. Data zůstávají pouze ve vašem počítači.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Sdílená paměť pro AI",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "background": {
    "service_worker": "background/serviceWorker.js"
  },
  "commands": {
    "toggle-memory-preview": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Otevřít náhled paměti pro aktuální dotaz"
    }
  },
  "permissions": ["storage", "sidePanel", "scripting"],
  "optional_host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*"
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'"
  }
}
